rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Siapa saja bisa melihat file/gambar di Storage
    // Hanya pengguna yang terautentikasi (Admin) yang bisa mengunggah atau menghapus file
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
